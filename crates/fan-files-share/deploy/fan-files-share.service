[Unit]
Description=fan-files metadata sharing service
After=network.target

[Service]
Type=simple
User=fan-files-share
Group=fan-files-share
ExecStart=/usr/local/bin/fan-files-share --config /etc/fan-files-share.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/fan-files/.fan-files/data

[Install]
WantedBy=multi-user.target
